# ==============================================================================
# E-Summit 2026 Backend Environment Template
# ==============================================================================
# 
# TODO (DevOps):
# 1. Copy this file to backend/.env:
#    cp .env.example .env
#
# 2. Generate secure random secrets (minimum 32 characters) using:
#    openssl rand -hex 32
# ==============================================================================

# ── Runtime ──
NODE_ENV=production
PORT=4000

# TODO (DevOps): Set to your exact production origins (comma-separated, no trailing slashes)
CORS_ORIGINS=https://esummit.pec.ac.in,https://admin.esummit.pec.ac.in

# ── Data Stores ──
# TODO (DevOps): Connect your MongoDB Atlas cluster URI or VPS MongoDB
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/esummit?retryWrites=true&w=majority&appName=Cluster0
REDIS_URL=redis://localhost:6380

# ── Authentication & Security ──
# TODO (DevOps): Replace with unique 64-char hex strings generated via `openssl rand -hex 32`
JWT_ACCESS_SECRET=replace_with_openssl_rand_hex_32_min_32_chars
JWT_REFRESH_SECRET=replace_with_openssl_rand_hex_32_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Gate Entry & QR Verification ──
# TODO (DevOps): Replace with unique 64-char hex string generated via `openssl rand -hex 32`
QR_HMAC_SECRET=replace_with_openssl_rand_hex_32_min_32_chars

# ── Payment Gateway (Razorpay) ──
# TODO (DevOps): Add live Razorpay credentials when going to production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email Service (Resend / Transactional Passes) ──
# TODO (DevOps): Add Resend API key for automated QR badge delivery to attendees
RESEND_API_KEY=
MAIL_FROM=PEC E-Summit 2026 <no-reply@esummit.pec.ac.in>

# ── Cloudinary Media Storage ──
# TODO (DevOps): Configure Cloudinary credentials for speaker avatars & event posters
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or full connection URL: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

